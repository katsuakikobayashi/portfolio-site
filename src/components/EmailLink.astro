---
/**
 * クリックでメールアドレスをクリップボードにコピーするリンク。
 * Clipboard API が使えない環境や書き込みに失敗した場合は、
 * 通常どおり mailto: リンクとして遷移する（プログレッシブエンハンスメント）。
 */
interface Props {
  email: string
  copiedLabel: string
  class?: string
}

const { email, copiedLabel, class: className } = Astro.props
---

<a class:list={['c-link', 'js-email-link', className]} href={`mailto:${email}`} data-email={email}>
  {email}
</a>
<span class="p-email-link__status" data-email-status role="status" aria-live="polite" hidden>
  {copiedLabel}
</span>

<script>
  /**
   * @function initEmailCopyLinks
   * @description `.js-email-link` を持つリンクのクリックを横取りし、mailto 遷移の代わりに
   *              メールアドレスをクリップボードへコピーする。コピーに失敗した場合や
   *              Clipboard API が利用できない場合は通常の mailto 遷移にフォールバックする。
   * @returns {void}
   */
  function initEmailCopyLinks(): void {
    const links = document.querySelectorAll<HTMLAnchorElement>('.js-email-link')

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const email = link.dataset['email']
        if (!email || !navigator.clipboard) {
          return
        }

        event.preventDefault()
        navigator.clipboard
          .writeText(email)
          .then(() => showCopiedStatus(link))
          .catch(() => {
            window.location.href = link.href
          })
      })
    })
  }

  /**
   * @function showCopiedStatus
   * @description リンクに隣接するステータス要素を一時的に表示し、コピー完了を伝える
   * @param {HTMLAnchorElement} link - コピー操作の起点となったリンク
   * @returns {void}
   */
  function showCopiedStatus(link: HTMLAnchorElement): void {
    const status = link.nextElementSibling
    if (!(status instanceof HTMLElement)) {
      return
    }

    status.hidden = false
    window.setTimeout(() => {
      status.hidden = true
    }, 2000)
  }

  initEmailCopyLinks()
</script>
