---
import Profile from '@/components/Profile.astro'
import Slideshow from '@/components/Slideshow.astro'
import type { Locale } from '@/i18n/config'
import type { TopSlide } from '@/lib/page-content'

/**
 * TOP ページ本体。左カラムにプロフィール、第 3 カラムに CMS のスライド写真（PC のみ）。
 *
 * @prop {Locale} locale - 表示ロケール
 * @prop {TopSlide[]} slides - microCMS `top.sliderImages` を変換済みのスライド
 */
interface Props {
  locale: Locale
  slides: TopSlide[]
}

const { locale, slides } = Astro.props
---

<main class="l-page__main l-grid p-top">
  <Profile class="p-top__profile" locale={locale} isPageHeading />
  <Slideshow class="p-top__slideshow" slides={slides} />
</main>
