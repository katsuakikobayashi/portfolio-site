---
import AboutView from '@/components/AboutView.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { ABOUT_PHOTO } from '@/data/media'
import type { Locale } from '@/i18n/config'
import { useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getContent } from '@/lib/microcms'
import { buildResponsiveImage } from '@/lib/microcms/image'
import { toDescription, toParagraphs } from '@/lib/text'

/**
 * About ページ（ja / en 共通）。microCMS `about` を取得してビューへ渡す。
 * 写真はホバー時にのみ表示する補助的な要素のため preload しない。
 *
 * @prop {Locale} locale - 表示ロケール
 */
interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const about = await getContent('about')

const isJa = locale === 'ja'
const name = isJa ? about.name : about.nameEn
const text = isJa ? about.text : about.textEn
// 和文は行をそのまま連結し、欧文は単語が繋がらないよう空白で連結する
const description = toDescription(text, isJa ? '' : ' ')
const photo =
  about.image && buildResponsiveImage(about.image, ABOUT_PHOTO.displayWidth, ABOUT_PHOTO.sizes)
---

<BaseLayout
  locale={locale}
  title={`${t('nav.about')} | ${t('meta.title')}`}
  description={description}
  withJapaneseFont={isJa}
>
  <AboutView
    locale={locale}
    name={name}
    paragraphs={toParagraphs(text)}
    photo={photo}
    photoCaption={about.imageCaption}
  />
  <SiteFooter locale={locale} pathname={Astro.url.pathname} current="about" />
</BaseLayout>
