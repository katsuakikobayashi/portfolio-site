---
import SiteFooter from '@/components/SiteFooter.astro'
import TopView from '@/components/TopView.astro'
import { PC_MEDIA_QUERY } from '@/data/media'
import type { Locale } from '@/i18n/config'
import { useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getContent } from '@/lib/microcms'
import { getPreferredSource } from '@/lib/microcms/image'
import { toTopSlides } from '@/lib/page-content'

/**
 * TOP ページ（ja / en 共通）。microCMS `top` を取得してビューへ渡す。
 *
 * @prop {Locale} locale - 表示ロケール
 * @prop {boolean} isPreview - 下書きプレビュー（/preview/）として出力するか。
 *   true の場合は CMS を取得せず空の状態で出力し、下書きはブラウザで取得して描画する
 */
interface Props {
  locale: Locale
  isPreview?: boolean
}

const { locale, isPreview = false } = Astro.props
const t = useTranslations(locale)
const slides = isPreview ? [] : toTopSlides(await getContent('top'), locale)
const [firstSlide] = slides
---

<BaseLayout
  locale={locale}
  title={t('meta.title')}
  description={t('meta.description')}
  previewPage={isPreview ? 'top' : undefined}
  preloadImage={
    firstSlide && {
      ...getPreferredSource(firstSlide.image),
      sizes: firstSlide.image.sizes,
      media: PC_MEDIA_QUERY,
    }
  }
>
  <TopView locale={locale} slides={slides} />
  <SiteFooter locale={locale} pathname={Astro.url.pathname} current="top" />
</BaseLayout>
